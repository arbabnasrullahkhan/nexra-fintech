{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/promo", "destination": "/promo.html" },
    { "source": "/ad", "destination": "/ad/index.html" },
    { "source": "/ad/:match*", "destination": "/ad/:match*.html" },
    { "source": "/d", "destination": "/d/h.html" },
    { "source": "/d/h", "destination": "/d/h.html" },
    { "source": "/d/m", "destination": "/d/m.html" },
    { "source": "/d/n", "destination": "/d/n.html" },
    { "source": "/d/p", "destination": "/d/p.html" },
    { "source": "/d/r", "destination": "/d/r.html" },
    { "source": "/d/rev", "destination": "/d/rev.html" },
    { "source": "/d/s", "destination": "/d/s.html" },
    { "source": "/d/sp", "destination": "/d/sp.html" },
    { "source": "/d/st", "destination": "/d/st.html" },
    { "source": "/d/str", "destination": "/d/str.html" },
    { "source": "/d/t", "destination": "/d/t.html" },
    { "source": "/d/v", "destination": "/d/v.html" },
    { "source": "/d/w", "destination": "/d/w.html" },
    { "source": "/a/c", "destination": "/a/c.html" },
    { "source": "/a/f", "destination": "/a/f.html" },
    { "source": "/a/l", "destination": "/a/l.html" },
    { "source": "/a/p", "destination": "/a/p.html" },
    { "source": "/a/pt", "destination": "/a/pt.html" },
    { "source": "/a/r", "destination": "/a/r.html" }
  ]
}
